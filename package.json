{
  "name": "us-legends-configurator-3js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "US Legends 3D car builder, rebuilt on Three.js (no Sketchfab).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "models:placeholder": "node scripts/make-placeholder-models.mjs",
    "models:inspect": "node scripts/inspect-model.mjs",
    "models:optimize": "node scripts/optimize-model.mjs",
    "models:c4d": "node --max-old-space-size=8192 scripts/build-c4d-models.mjs",
    "build:preview": "node scripts/make-preview-models.mjs && vite build --mode preview && node -e \"require('fs').rmSync('src/assets/models-preview',{recursive:true,force:true})\"",
    "build:demo": "vite build --mode demo"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "vite": "^8.3.3"
  }
}
